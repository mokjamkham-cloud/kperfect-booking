NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production public URLs used by npm run build:cloudflare
# NEXT_PUBLIC_API_BASE_URL=https://kperfect-booking-api.mokjamkham.workers.dev
# NEXT_PUBLIC_SITE_URL=https://kperfect-booking-api.mokjamkham.workers.dev

# Worker local development. Copy these values into .dev.vars for wrangler dev.
APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ADMIN_API_KEY=change-this-admin-key
ADMIN_USER=kperfect-staff
SESSION_SECRET=replace-with-at-least-32-random-characters
ENABLE_DEV_AUTH=true

# LINE Login channel
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=http://localhost:8787/api/auth/line/callback

# LINE Messaging API channel
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_GROUP_ID=

# Booking configuration
BRANCH_NAME=K Perfect Nails - Nimman
SHOP_TIMEZONE=Asia/Bangkok
SHOP_OPEN_TIME=09:00
SHOP_CLOSE_TIME=20:00
SERVICE_DURATION_MINUTES=120
SLOT_INTERVAL_MINUTES=60
MAX_ONLINE_SEATS=2
MAX_BOOKINGS_PER_USER=2
MAX_ADVANCE_DAYS=7
ALLOW_SAME_DAY_BOOKING=false
BOOKING_RETENTION_DAYS=10
