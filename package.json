{
  "name": "kperfect-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "wrangler dev --local --port 8787",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "deploy:worker": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kperfect-booking-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kperfect-booking-db --remote",
    "db:seed:local": "wrangler d1 execute kperfect-booking-db --local --file=database/seed.sql"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260620.0",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.21.0"
  }
}
